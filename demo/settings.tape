# Shared look for every chapter. Sourced by demo/tapes/*.tape.
# 1632x840: the content area of the window frame demo/style.py draws. The
# colours are the demo palette only (demo/style.py).
Set Shell "bash"
Set FontFamily "JetBrains Mono"
Set FontSize 22
Set LineHeight 1.3
Set Width 1632
Set Height 840
Set Padding 32
Set Theme { "name": "UDS demo", "black": "#050709", "red": "#F8FAFC", "green": "#34D399", "yellow": "#F5B82E", "blue": "#E5A00D", "magenta": "#F5B82E", "cyan": "#E5A00D", "white": "#CBD5E1", "brightBlack": "#8B98A8", "brightRed": "#F8FAFC", "brightGreen": "#34D399", "brightYellow": "#FCD34D", "brightBlue": "#F5B82E", "brightMagenta": "#F5B82E", "brightCyan": "#F5B82E", "brightWhite": "#F8FAFC", "background": "#0B0E11", "foreground": "#CBD5E1", "selection": "#171E27", "cursor": "#E5A00D" }
Set BorderRadius 0
Set Margin 0
Set Framerate 30
Set TypingSpeed 75ms
Set CursorBlink false
