# Build-time tools from official releases; keep versions aligned with mise.toml.
set -eu

[ "$#" -eq 1 ] || { echo 'usage: install-tools DESTINATION' >&2; exit 2; }
destination=$1
helm_version=4.3.1
shellcheck_version=0.11.0

# Helm checksums: https://github.com/helm/helm/releases/tag/v4.3.1
# ShellCheck checksums: official release asset SHA256 digests at
# https://github.com/koalaman/shellcheck/releases/tag/v0.11.0
case "$(dpkg --print-architecture)" in
  amd64)
    helm_arch=amd64
    helm_sha=0403a88ae20913d11b10a2467b50087721fea7581736da6b9d3992f5357fe54b
    shellcheck_arch=x86_64
    shellcheck_sha=b7af85e41cc99489dcc21d66c6d5f3685138f06d34651e6d34b42ec6d54fe6f6
    ;;
  arm64)
    helm_arch=arm64
    helm_sha=8cf8f66ecbc252ac8f7f06cca68aba88508ddfde3a6a34feb1678ad1694b4f88
    shellcheck_arch=aarch64
    shellcheck_sha=68a8133197a50beb8803f8d42f9908d1af1c5540d4bb05fdfca8c1fa47decefc
    ;;
  *) echo 'Development tools support only Linux amd64 and arm64.' >&2; exit 1 ;;
esac

temporary=$(mktemp -d)
trap 'rm -rf "${temporary}"' EXIT HUP INT TERM
curl --fail --location --proto '=https' --proto-redir '=https' --tlsv1.2 \
  --retry 3 --connect-timeout 15 --max-time 120 \
  --output "${temporary}/helm.tar.gz" \
  "https://get.helm.sh/helm-v${helm_version}-linux-${helm_arch}.tar.gz"
curl --fail --location --proto '=https' --proto-redir '=https' --tlsv1.2 \
  --retry 3 --connect-timeout 15 --max-time 120 \
  --output "${temporary}/shellcheck.tar.gz" \
  "https://github.com/koalaman/shellcheck/releases/download/v${shellcheck_version}/shellcheck-v${shellcheck_version}.linux.${shellcheck_arch}.tar.gz"
# Verify both payloads before extracting or installing either executable.
printf '%s  %s\n' "${helm_sha}" "${temporary}/helm.tar.gz" \
  "${shellcheck_sha}" "${temporary}/shellcheck.tar.gz" | sha256sum --check --status
tar -xzf "${temporary}/helm.tar.gz" -C "${temporary}" "linux-${helm_arch}/helm"
tar -xzf "${temporary}/shellcheck.tar.gz" -C "${temporary}" "shellcheck-v${shellcheck_version}/shellcheck"
install -d "${destination}"
install -m 0755 "${temporary}/linux-${helm_arch}/helm" "${destination}/helm"
install -m 0755 "${temporary}/shellcheck-v${shellcheck_version}/shellcheck" "${destination}/shellcheck"
