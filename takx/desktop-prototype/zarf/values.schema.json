{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Copyright 2026 uds-takserver authors. SPDX-License-Identifier: GPL-3.0-only",
  "title": "takx-desktop package values",
  "type": "object",
  "additionalProperties": false,
  "required": ["global", "identity", "desktop"],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain"],
      "properties": {
        "domain": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$",
          "description": "Domain suffix of the UDS gateways."
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "callsign", "group"],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
          "description": "TakClient and device Secret name in namespace takclients. It is written into a shell command, so only a DNS label is accepted."
        },
        "callsign": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{3,62}$",
          "description": "Certificate common name and TAK user name."
        },
        "group": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,62}$",
          "description": "TAK group, without slashes."
        }
      }
    },
    "desktop": {
      "type": "object",
      "description": "Values of the takx-desktop chart. The chart's own schema checks them when it is installed."
    }
  }
}
