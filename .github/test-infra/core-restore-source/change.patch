diff --git a/src/velero/tasks.yaml b/src/velero/tasks.yaml
index 09db579..41b6e39 100644
--- a/src/velero/tasks.yaml
+++ b/src/velero/tasks.yaml
@@ -13,8 +13,27 @@ tasks:
   - name: validate
     actions:
       - task: health-check
+      - task: validate-restore-policy-schema
       - task: execute-backup
 
+  - name: validate-restore-policy-schema
+    description: Validate the Restore resource policy API without persisting a restore
+    actions:
+      - description: Dry-run a Restore with a resource policy reference
+        cmd: |-
+          uds zarf tools kubectl create --dry-run=server --validate=strict -f - >/dev/null <<'EOF'
+          apiVersion: velero.io/v1
+          kind: Restore
+          metadata:
+            generateName: uds-restore-policy-schema-
+            namespace: velero
+          spec:
+            backupName: schema-validation-only
+            resourcePolicy:
+              kind: configmap
+              name: schema-validation-only
+          EOF
+
   - name: health-check
     actions:
       - description: Velero StatefulSet Health Check
