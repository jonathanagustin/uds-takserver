{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Copyright 2026 uds-takserver authors. SPDX-License-Identifier: GPL-3.0-only",
  "title": "takx-desktop chart values",
  "type": "object",
  "additionalProperties": false,
  "required": ["domain", "host", "image", "imagePullPolicy", "sso", "display", "jvm", "takx", "identity", "tak", "egress", "persistence", "resources"],
  "definitions": {
    "dnsLabel": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"},
    "dnsName": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$", "maxLength": 253},
    "optionalDnsName": {"type": "string", "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*)?$", "maxLength": 253},
    "quantity": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|M|Mi|G|Gi|T|Ti)?$"},
    "resourceList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"cpu": {"$ref": "#/definitions/quantity"}, "memory": {"$ref": "#/definitions/quantity"}}
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {"requests": {"$ref": "#/definitions/resourceList"}, "limits": {"$ref": "#/definitions/resourceList"}}
    }
  },
  "properties": {
    "domain": {"$ref": "#/definitions/dnsName", "description": "Domain suffix of the UDS gateways."},
    "host": {"$ref": "#/definitions/dnsLabel", "description": "Host under the domain on the tenant gateway."},
    "image": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s]+$",
      "description": "Image reference of all three containers."
    },
    "imagePullPolicy": {"enum": ["IfNotPresent", "Always", "Never"]},
    "sso": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientId", "groups"],
      "properties": {
        "clientId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,254}$", "description": "Keycloak client ID. Authservice does not accept a colon."},
        "groups": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^/.+"},
          "description": "Keycloak group paths that may open the desktop. At least one: an empty list would admit every user of the realm."
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geometry", "depth"],
      "properties": {
        "geometry": {"type": "string", "pattern": "^[0-9]{3,5}x[0-9]{3,5}$"},
        "depth": {"enum": [16, 24, 32]}
      }
    },
    "jvm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extraOpts"],
      "properties": {"extraOpts": {"type": "string"}}
    },
    "takx": {
      "type": "object",
      "additionalProperties": false,
      "required": ["args"],
      "properties": {"args": {"type": "string"}}
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretName", "expectHost", "connectHost"],
      "properties": {
        "secretName": {"$ref": "#/definitions/dnsName"},
        "expectHost": {"$ref": "#/definitions/optionalDnsName"},
        "connectHost": {"$ref": "#/definitions/optionalDnsName"}
      }
    },
    "tak": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certName", "gateway", "egress", "hostAliases"],
      "properties": {
        "certName": {"$ref": "#/definitions/dnsName"},
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "service", "selector", "ip"],
          "properties": {
            "namespace": {"$ref": "#/definitions/dnsLabel"},
            "service": {"$ref": "#/definitions/dnsLabel"},
            "selector": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
            "ip": {"type": "string", "pattern": "^(([0-9]{1,3}\\.){3}[0-9]{1,3})?$"}
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["streaming", "api"],
          "properties": {"streaming": {"type": "boolean"}, "api": {"type": "boolean"}}
        },
        "hostAliases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ip", "hostnames"],
            "properties": {
              "ip": {"type": "string", "minLength": 1},
              "hostnames": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/dnsName"}}
            }
          }
        }
      }
    },
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hosts"],
      "properties": {
        "hosts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/dnsName"},
          "description": "External hosts on TCP 443. No wildcard: the UDS operator rejects one."
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "size", "storageClass"],
      "properties": {
        "enabled": {"type": "boolean"},
        "size": {"$ref": "#/definitions/quantity"},
        "storageClass": {"type": "string"}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "desktop", "web"],
      "properties": {
        "identity": {"$ref": "#/definitions/resources"},
        "desktop": {"$ref": "#/definitions/resources"},
        "web": {"$ref": "#/definitions/resources"}
      }
    },
    "global": {"type": "object", "description": "Reserved by Helm."}
  }
}
